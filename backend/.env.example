# ===========================================
# ANUBIS CODEX - API Configuration
# ===========================================

# -------------------------------------------
# LLM API (REQUIRED for AI chat functionality)
# -------------------------------------------
# Option 1: OpenRouter (recommended - supports multiple models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option 2: OpenAI (alternative to OpenRouter)
# OPENAI_API_KEY=your_openai_api_key_here

# LLM Model Configuration
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-3.5-turbo

# LLM Parameters (optional)
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30

# -------------------------------------------
# GitHub API (OPTIONAL - for higher rate limits)
# -------------------------------------------
# Without this token, the app works but may hit GitHub API rate limits
# Get your token at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# -------------------------------------------
# Embedding Configuration (LOCAL - no API key needed)
# -------------------------------------------
# Uses sentence-transformers locally
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# -------------------------------------------
# Vector Database (LOCAL - no API key needed)
# -------------------------------------------
VECTOR_DB_PATH=cache/vector_db

# -------------------------------------------
# Cache Configuration
# -------------------------------------------
CACHE_DIR=/tmp/anubis-codex-cache

# -------------------------------------------
# Backend Server Configuration
# -------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# -------------------------------------------
# Frontend Configuration
# -------------------------------------------
VITE_API_BASE=http://127.0.0.1:8000
